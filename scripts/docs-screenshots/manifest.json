                {"click": "button[title='Download']"},
                {"waitFor": "#feedExportModal .modal-content"},
                {"eval": "(() => { const d = new Date(Date.now() - 7*864e5); const p = n => String(n).padStart(2, '0'); const el = document.getElementById('export-start'); el.value = `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} 00:00:00`; el.dispatchEvent(new Event('input', { bubbles: true })); })()"}
            ],
            "element": "#feedExportModal .modal-content"
        },
