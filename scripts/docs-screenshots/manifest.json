            "name": "inputs-1-list",
            "page": "inputs.md",
            "url": "input/view",
            "waitFor": ".group-list-header",
            "actions": [
                {"eval": "document.querySelectorAll('.group-list-group').forEach(g => { const h = g.querySelector('.group-list-header'); if (h && !/^\\s*(emontx4|emonth2)\\b/.test(h.querySelector('[data-col=name]')?.textContent || h.textContent)) g.style.display = 'none'; })"}
